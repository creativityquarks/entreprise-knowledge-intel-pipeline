FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Run Bronze fetch (dumps to GCS) -> Silver BigQuery MERGE -> Gold dbt build
CMD ["sh", "-c", "python fetch_live.py --generated && python load_silver_to_bigquery.py && python build_gold.py"]
